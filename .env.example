# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/v1
CORS_ORIGIN=*
LOG_LEVEL=info

# ---- Database ----
# Runtime uses the pooled connection; migrations use the direct connection.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tapprint?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tapprint?schema=public

# ---- JWT ----
# Use `openssl rand -hex 32` to generate strong secrets (min 32 chars).
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-00000000000
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
JWT_SESSION_TTL=1800
JWT_AGENT_TTL=3600

# ---- AWS S3 (or S3-compatible) ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=tapprint-documents
S3_ENDPOINT=
S3_UPLOAD_URL_TTL=300
S3_DOWNLOAD_URL_TTL=300

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ---- Uploads ----
MAX_UPLOAD_BYTES=52428800
